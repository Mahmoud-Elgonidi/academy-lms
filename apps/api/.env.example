APP_NAME="Academy LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lms
# The app connects as lms_app (RLS applies). See database/setup/roles.sql.
DB_USERNAME=lms_app
DB_PASSWORD=app
# Migrations only: composer migrate (php artisan migrate --database=pgsql_owner)
DB_OWNER_USERNAME=lms_owner
DB_OWNER_PASSWORD=owner
# BYPASSRLS, platform code only
DB_PLATFORM_USERNAME=lms_platform
DB_PLATFORM_PASSWORD=platform

# Academies resolve by subdomain of this host ({slug}.lms.test) or by a verified custom domain.
PLATFORM_DOMAIN=lms.test
# Local only: the academy for plain localhost (ignored unless APP_ENV=local).
PLATFORM_DEV_ACADEMY=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Live classroom: LiveKit (docker compose runs one with these development keys), or "external" for teachers' own links.
CLASSROOM_PROVIDER=livekit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-dev-secret-not-for-production-0001

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
