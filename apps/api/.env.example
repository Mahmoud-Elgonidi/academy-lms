APP_NAME="Academy LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lms
# The app connects as lms_app (RLS applies). See database/setup/roles.sql.
DB_USERNAME=lms_app
DB_PASSWORD=app
# Migrations only: composer migrate (php artisan migrate --database=pgsql_owner)
DB_OWNER_USERNAME=lms_owner
DB_OWNER_PASSWORD=owner
# BYPASSRLS, platform code only
DB_PLATFORM_USERNAME=lms_platform
DB_PLATFORM_PASSWORD=platform

# Academies resolve by subdomain of this host ({slug}.lms.test) or by a verified custom domain.
PLATFORM_DOMAIN=lms.test
# Local only: the academy for plain localhost (ignored unless APP_ENV=local).
PLATFORM_DEV_ACADEMY=
# One academy on the platform's own host (APP_URL/admin, /teach, /my) when academy subdomains have no DNS; any environment.
PLATFORM_HOME_ACADEMY=
# The platform team's console: APP_URL/console when empty; in production its own host (console.<domain>).
PLATFORM_CONSOLE_DOMAIN=
PLATFORM_CONSOLE_URL=
# The platform's own privacy notice, terms and account-deletion page (on its address).
PLATFORM_LEGAL_NAME=
PRIVACY_CONTACT_EMAIL=
# The mobile app: older versions open on an update screen (GET /branding → app); the store pages it sends people to.
APP_MIN_VERSION=1.0.0
APP_ANDROID_URL=
APP_IOS_URL=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Live classroom: LiveKit (docker compose runs one with these development keys), or "external" for teachers' own links.
CLASSROOM_PROVIDER=livekit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-dev-secret-not-for-production-0001
# Recording lessons: LiveKit Egress (defaults to LIVEKIT_API_URL), and where the files go
# (a disk; for a local one, RECORDINGS_RECORDER_ROOT is that folder as Egress sees it).
LIVEKIT_EGRESS_URL=
RECORDINGS_DISK=local
RECORDINGS_RECORDER_ROOT=

# Signing in with Google and Apple (off while empty). The platform's own clients: register
# {SOCIAL_REDIRECT_BASE}/auth/social/google/callback and .../apple/callback with them.
SOCIAL_REDIRECT_BASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The apps' own Google clients (Android, iOS), comma-separated.
GOOGLE_APP_CLIENT_IDS=
# Apple: the Services ID for the web, and the apps' bundle ids (comma-separated).
APPLE_SERVICES_ID=
APPLE_APP_IDS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Live screens (the live board): Reverb, started with `php artisan reverb:start`,
# and `php artisan scheduling:live`, which passes database changes to it.
REVERB_APP_ID=lms-local
REVERB_APP_KEY=lms-local-key
REVERB_APP_SECRET=lms-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Where browsers connect, if not the page's own host on REVERB_PORT:
# REVERB_PUBLIC_HOST=ws.example.com
# REVERB_PUBLIC_PORT=443
# REVERB_PUBLIC_SCHEME=https

# Online payments: each academy connects its own gateway accounts (Settings › Online payments).
# A pretend gateway with its own page, to try the flow without keys; off in production whatever this says.
BILLING_DEMO_GATEWAY=true
# Stripe Connect (later): the platform's key, acting for each academy's connected account.
# STRIPE_PLATFORM_SECRET=
# Stripe Connect Standard (an academy connects its own Stripe account): the platform's Connect client id,
# the Connect webhook's signing secret (endpoint: {APP_URL}/webhooks/stripe-connect), where Stripe returns
# after connecting (default {APP_URL}/billing/stripe/connected; register it in Stripe), and the platform's fee.
# STRIPE_CONNECT_CLIENT_ID=
# STRIPE_CONNECT_WEBHOOK_SECRET=
# STRIPE_CONNECT_REDIRECT=
# STRIPE_APPLICATION_FEE_BP=0
# Paymob outside Egypt has its own host (https://ksa.paymob.com, https://oman.paymob.com, ...).
# PAYMOB_API_BASE=https://accept.paymob.com

# Outside channels (Communication). Locally codes and messages go to the log (email to Mailpit under docker).
# WhatsApp Cloud API: notifications use WHATSAPP_META_TEMPLATE; sign-in codes an "authentication" template
# with a copy-code button, approved in Arabic and English.
# WHATSAPP_DRIVER=meta
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_OTP_TEMPLATE=sign_in_code
# Texts carry sign-in codes only: log | twilio | none.
# SMS_DRIVER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# Push to the mobile app (Firebase Cloud Messaging HTTP v1): log | fcm. The app gets the same project's settings at build time.
# PUSH_DRIVER=fcm
# FCM_PROJECT_ID=
# FCM_CREDENTIALS=/path/to/service-account.json

# The games studio's designer (console › Game studio): Claude with the platform's own key.
# Without a key and a model the studio still lists, previews and publishes games; it says the designer is not set up.
# ANTHROPIC_API_KEY=
# GAME_DESIGNER_MODEL=   (a Claude model id from Anthropic's models list; the most capable one designs best)
# Locally, without a key: GAME_DESIGNER=demo answers with one of the platform's games (never in production).
# GAME_DESIGNER=claude
# GAME_DESIGNER_EFFORT=high

# The academies' AI helpers (Settings › AI helpers; each academy turns each one on): the same Claude key, and
# ElevenLabs for the ones that listen. Locally, without keys: AI_DRIVER=demo answers with fixed drafts and
# hears what a recording's .txt beside it says (never in production). AI_DRIVER=off turns them all off.
# AI_DRIVER=demo
# AI_MODEL=claude-opus-5-5
# AI_FAST_MODEL=claude-haiku-5-5
# ELEVENLABS_API_KEY=
