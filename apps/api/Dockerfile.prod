# syntax=docker/dockerfile:1
#
# The production image (infra/deploy): one image for the whole app; the
# command picks the part (infra/deploy/entrypoint.sh): web (FrankenPHP serving
# public/, with Reverb's browser connections passed on under /app/ and the
# portal's pages to the portal), portal (apps/web, Next's own server), reverb,
# worker, scheduler, relay, and the one-off migrate and seed-demo; the offsite
# part runs infra/deploy/offsite.sh on it.
#
# Built from the repository root:
#   docker build -f apps/api/Dockerfile.prod -t academy-lms .
# The development image is ./Dockerfile (docker compose up at the root).

# The portal (apps/web): Next's standalone server, built here; the final image
# takes it and Node's binary from this stage.
FROM node:22-bookworm-slim AS portal
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build \
    && cp -r .next/static .next/standalone/.next/static

FROM dunglas/frankenphp:1-php8.3-bookworm

# age, rclone and psql are the off-site copy's (infra/deploy/offsite.sh): it
# encrypts each backup to the platform team's public key and sends it to a bucket.
# timezonedb: the latest clock rules at build time, not the copy inside PHP's release
# (Morocco on UTC+0 for good from 20 September 2026 came in tzdata 2026c).
RUN install-php-extensions pdo_pgsql pgsql intl zip bcmath pcntl redis opcache timezonedb \
    && apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin age postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY --from=rclone/rclone:1.68.2 /usr/local/bin/rclone /usr/local/bin/rclone
COPY infra/deploy/php.ini "$PHP_INI_DIR/conf.d/zz-academy.ini"
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

ENV APP_ENV=production \
    LOG_CHANNEL=stderr \
    COMPOSER_ALLOW_SUPERUSER=1

WORKDIR /app

# Packages first, so a code change does not download them again.
COPY apps/api/composer.json apps/api/composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-progress --no-scripts --no-autoloader \
    && rm -rf /root/.composer/cache

COPY apps/api/ ./
COPY --from=portal /usr/local/bin/node /usr/local/bin/node
COPY --from=portal /web/.next/standalone /portal
COPY infra/deploy/Caddyfile /etc/academy/Caddyfile
COPY --chmod=755 infra/deploy/entrypoint.sh /usr/local/bin/academy

# The class map, package discovery and Filament's published assets (public/css,
# public/js); then the folders the app writes to, owned by www-data. It runs as
# www-data on port 8080, so FrankenPHP needs no capability to bind low ports
# (and compose's no-new-privileges would refuse a binary that asks for one).
RUN composer dump-autoload --no-dev --optimize --no-interaction \
    && mkdir -p resources/views storage/app/public storage/framework/cache/data storage/framework/sessions \
        storage/framework/views storage/logs bootstrap/cache \
    && ln -sfn /app/storage/app/public public/storage \
    && rm -f bootstrap/cache/*.php .env \
    && chown -R www-data:www-data storage bootstrap/cache /data/caddy /config/caddy /portal/.next \
    && (setcap -r /usr/local/bin/frankenphp || true) \
    && node --version >/dev/null

USER www-data
EXPOSE 8080
ENTRYPOINT ["academy"]
CMD ["web"]
