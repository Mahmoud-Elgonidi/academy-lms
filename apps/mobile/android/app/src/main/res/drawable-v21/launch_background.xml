<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Android 12: the product's green with the app's mark in the middle (tool/icon.py draws
     splash_mark.png at the size the app's first screen draws it). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
